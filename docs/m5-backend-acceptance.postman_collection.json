{
  "info": {
    "name": "Fluxpay M5 — isolated backend acceptance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use only with the test-only M5 solo launcher and dedicated Oracle schema. Read docs/M5-BACKEND-SETUP-AND-UAT.md. Set private signed tokens locally; do not export populated secrets. Run requests in order. Copy fresh paymentId/fingerprint/nextSequence from fixture metadata before each new assessment cycle. Replays must retain the original ID/sequence/fingerprint. This collection does not create Oracle users, reset tables, or move money."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8081",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "foreignUserToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "expectedPaymentFingerprint",
      "value": "",
      "type": "string"
    },
    {
      "key": "assessmentSequence",
      "value": "1",
      "type": "string"
    },
    {
      "key": "assessmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "caseId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reviewReference",
      "value": "",
      "type": "string"
    },
    {
      "key": "policyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "policyText",
      "value": "M5 synthetic support policy. When a payout attempt fails, the customer may request a retry, an alternative route, or a refund. A compliance approval alone does not submit a payout.",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response has a correlation envelope', function () {",
          "  const value = pm.response.json();",
          "  pm.expect(value.correlationId).to.be.a('string').and.not.empty;",
          "  if (pm.response.code < 400) pm.expect(value).to.have.property('data');",
          "  else ['code','message','fieldErrors','ts'].forEach(key => pm.expect(value).to.have.property(key));",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 — Identity and fixture metadata",
      "item": [
        {
          "name": "Fixture metadata — copy payment/fingerprint/next sequence",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/m5-solo/fixtures",
            "description": "Choose an owned fixture payment and copy its immutable fingerprint and nextSequence into collection variables. Never use old V603 payment IDs for this new test harness."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('assessmentId')) pm.collectionVariables.set('assessmentId', pm.variables.replaceIn('{{$guid}}'));",
                  "if (!pm.collectionVariables.get('reviewReference')) pm.collectionVariables.set('reviewReference', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Unsigned policy list must fail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/policies",
            "description": "No X-Role or X-User-Id bypass is supported.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([401]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Signed USER cannot administer policies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/policies",
            "description": "Use the userToken from the private signed-token file.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([403]); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — Assessment, active review and decision replay",
      "item": [
        {
          "name": "Select two-MEDIUM risk scenario",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/m5-solo/fixtures/{{paymentId}}/scenario",
            "description": "Test-only control: alters the reader's observed KYC/history, not immutable payment fields or payment state.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario\": \"REVIEW\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create assessment (retain request identity)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/compliance/assess/{{paymentId}}",
            "description": "201 means new cycle; 200 means exact replay. On a fresh deliberate run allocate a NEW assessmentId and use the next sequence from metadata.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assessmentId\": \"{{assessmentId}}\",\n  \"assessmentSequence\": {{assessmentSequence}},\n  \"expectedPaymentFingerprint\": \"{{expectedPaymentFingerprint}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([201,200]); });",
                  "if (pm.response.code < 300) pm.collectionVariables.set('caseId', pm.response.json().data.caseId);",
                  "if (pm.response.code < 300) pm.collectionVariables.set('originalAssessmentJson', JSON.stringify(pm.response.json().data));"
                ]
              }
            }
          ]
        },
        {
          "name": "Exact replay — original response",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/compliance/assess/{{paymentId}}",
            "description": "Does not call the payment reader again.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assessmentId\": \"{{assessmentId}}\",\n  \"assessmentSequence\": {{assessmentSequence}},\n  \"expectedPaymentFingerprint\": \"{{expectedPaymentFingerprint}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "pm.test('Immutable assessment response', function () { pm.expect(pm.response.json().data).to.deep.equal(JSON.parse(pm.collectionVariables.get('originalAssessmentJson'))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Case before activation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/compliance/cases/{{caseId}}",
            "description": "Initially UNDER_REVIEW but reviewable=false; screening REVIEW alone is not an active hold."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Approval before activation must fail",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/compliance/cases/{{caseId}}/approve",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Synthetic review complete.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([409]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Activate confirmed review (fixture callback)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/m5-solo/dispositions",
            "description": "Simulates the post-commit M3 callback. Exact recorded callback replay is idempotent.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assessmentId\": \"{{assessmentId}}\",\n  \"disposition\": \"REVIEW_REQUIRED\",\n  \"reviewReference\": \"{{reviewReference}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reviewable queue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/compliance/cases?status=UNDER_REVIEW&risk=MEDIUM&reviewable=true&page=0&size=20",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve active case",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/compliance/cases/{{caseId}}/approve",
            "description": "Reviewer UUID comes from the ADMIN token. Do not send decidedBy.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Synthetic review complete.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay identical approval",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/compliance/cases/{{caseId}}/approve",
            "description": "Verify the same decision ID and only one durable decision row.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Synthetic review complete.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Changed approval reason must conflict",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/compliance/cases/{{caseId}}/approve",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"A different reason is a different command.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([409]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay assessment after manual approval",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/compliance/assess/{{paymentId}}",
            "description": "Original screening result remains unchanged by the manual decision.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assessmentId\": \"{{assessmentId}}\",\n  \"assessmentSequence\": {{assessmentSequence}},\n  \"expectedPaymentFingerprint\": \"{{expectedPaymentFingerprint}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "pm.test('Historical screening stays immutable', function () { pm.expect(pm.response.json().data).to.deep.equal(JSON.parse(pm.collectionVariables.get('originalAssessmentJson'))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Deliver pending decisions (fixture sink)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/m5-solo/deliver-pending",
            "description": "Use the Python verifier for acknowledgment-loss/retry and stale-reference scenarios.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Approved cases",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/compliance/cases?status=APPROVED&page=0&size=20",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Latest passport as owner",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/compliance/payments/{{paymentId}}/passport",
            "description": "Selected payment must be owned by userToken.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Foreign user passport must look missing",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/compliance/payments/{{paymentId}}/passport",
            "description": "Foreign access is intentionally indistinguishable from missing case.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{foreignUserToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([404]); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 — Immutable policies, indexing and grounded Copilot",
      "item": [
        {
          "name": "Create short controlled policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/policies",
            "description": "Content-only duplicate detection ignores title differences. A duplicate returns fieldErrors.existingPolicyDocumentId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"M5 Postman Synthetic Support\",\n  \"category\": \"SUPPORT\",\n  \"content\": \"{{policyText}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([201,409]); });",
                  "const value = pm.response.json();",
                  "if (pm.response.code === 201) pm.collectionVariables.set('policyId', value.data.id);",
                  "if (pm.response.code === 409 && value.code === 'DUPLICATE_POLICY') pm.collectionVariables.set('policyId', value.fieldErrors.existingPolicyDocumentId);"
                ]
              }
            }
          ]
        },
        {
          "name": "List policies and indexing states",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/policies?page=0&size=20",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Policy content and metadata",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/policies/{{policyId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Index policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/policies/{{policyId}}/index",
            "description": "Embeddings are produced before the atomic generation publication. Expect dimensions=768 and the current mock flag."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay index — no extra generation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/policies/{{policyId}}/index",
            "description": "Same model-space/chunker configuration should return existing active metadata without calling the provider."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Controlled exact-text grounding (mock acceptance)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
