  "cards": [
    {
      "dot": "cyan",
      "title": "Edge and services",
      "items": [
        "UI emits REST with JWT + Idempotency-Key; Router dispatches to Payment or Wallet",
        "Payment owns draft, quotes, confirm, payout; Wallet owns fund, convert, transfer, ledger",
        "Routing picks provider route and rail; FX supplies market rates for quotes"
      ]
    },
    {
      "dot": "emerald",
      "title": "Backend + ingestion why",
      "items": [
        "Payment writes ledger plus OutboxEvent/Delivery in one TX; Relay publishes later in order",
        "Kafka is the ingestion source for durability, ordering, replay, and outage survival",
        "Timeline consumer persists audit events; Recovery consumer retries 5x then refunds to DLT"
      ]
    },
    {
      "dot": "violet",
      "title": "Ollama + navigation",
      "items": [
        "Ollama embed (qwen3-embedding:4b 1536d) vectors policies; chat (qwen3:4b) answers only from evidence",
        "Copilot: embed query, Oracle vector search maxDistance 0.65, then grounded answer with sources",
        "Start at flux-api.ts, API Router controllers, PaymentService, WalletOperationService, EventTopics"
      ]
    }
  ]
